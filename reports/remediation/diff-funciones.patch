+def search_notes(
+    q: str = Query(min_length=1, max_length=50),
+    user=Depends(current_user),
+    conn=Depends(db.get_db),
+):
+    rows = conn.execute(
+        "SELECT id, title, content FROM notes WHERE owner_id = ? AND title LIKE ?",
+        (user["id"], f"%{q}%"),
+    ).fetchall()
     return [dict(r) for r in rows]

